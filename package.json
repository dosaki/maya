{
  "name": "maya",
  "private": true,
  "version": "0.14.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "ear:build": "sh scripts/build-ear.sh",
    "ear:test": "sh scripts/test-ear.sh",
    "version:set": "sh scripts/set-version.sh",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "build:mobile": "tsc && vite build --config vite.mobile.config.ts",
    "mobile": "cd mobile && tauri",
    "mobile:desktop": "cd mobile && tauri dev",
    "mobile:dev": "cd mobile && tauri android dev",
    "mobile:build": "cd mobile && tauri android build --apk --target aarch64"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.2"
  }
}
