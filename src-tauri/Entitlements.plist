<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The listener sidecar loads the bundled whisper.framework; under the
       hardened runtime a library must otherwise share the app's Team ID,
       which a self-signed or ad-hoc signature does not have. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Microphone access under the hardened runtime. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
