{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maya",
  "version": "0.4.0",
  "identifier": "com.dosaki.maya",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Maya",
        "width": 1280,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/maya-ear"
    ],
    "macOS": {
      "frameworks": [
        "../vendor/whisper.xcframework/macos-arm64_x86_64/whisper.framework"
      ],
      "entitlements": "Entitlements.plist"
    }
  }
}
